{
  "name": "format-lizard-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Browser-local formatter with background XML processing and large-file previews",
  "scripts": {
    "test": "node --test tests/worker.test.cjs && node tests/dom-checks.cjs",
    "test:worker": "node --test tests/worker.test.cjs",
    "test:dom": "node tests/dom-checks.cjs",
    "build:vendor": "esbuild node_modules/saxes/saxes.js --bundle --format=iife --global-name=XmlSaxes --outfile=vendor/saxes.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "saxes": "6.0.0"
  },
  "engines": { "node": ">=20" }
}
